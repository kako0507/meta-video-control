{
  "name": "meta-video-control",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.harvest.config.ts",
    "build:watch": "vite build --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test --project=offline",
    "test:e2e:live": "npm run build && playwright test --project=live --workers=1",
    "test": "npm run test:unit && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "demo": "npm run build && playwright test --project=demo && node scripts/make-demo-gif.mjs"
  },
  "keywords": [],
  "author": "Tim Kuo",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
